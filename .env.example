# ==========================================
# 环境变量模板
# 复制为 .env.development / .env.production 并修改对应值
# 只有 VITE_ 开头的变量会被打包进前端代码
# 注意：不要在环境变量里存放密钥等敏感信息
# 运行时配置以 system_configs 为准（见「系统设置」页），
# 以下变量降级为「构建期兜底默认值」，仅在后端未配置时生效
# ==========================================

# 默认语言（zh-CN / en）
VITE_APP_LOCALE=zh-cn

# 本地持久化存储的方式选择 local session
VITE_STORAGE_TYPE=local

# 接口基础路径
# 开发环境：相对路径，走 vite.config.ts 的 server.proxy 代理
# 生产环境：填后端完整地址（打包后 proxy 失效），如 https://api.example.com
VITE_APP_BASE_API=/api

# Axios 请求超时时间（毫秒）
VITE_APP_TIME_OUT=10000

# 是否启用本地 Mock（开发期 true；后端就绪后改为 false 走真实接口）
VITE_USE_MOCK=true

# 后端代理目标地址（仅开发环境生效）
VITE_APP_PROXY_TARGET=http://127.0.0.1:3000

# 开发服务器端口
VITE_APP_PORT=5173

# AI 对话超时时间
VITE_APP_HELP_AI_TIMEOUT=60000

# 构建基址（静态托管挂子路径时填写，如 /demo-app/；本地保持 /）
VITE_APP_BASE=/

# 文档站 Demo 内嵌地址（仅文档站构建读取；留空时回退本机 5173）
VITE_DEMO_APP_URL=



