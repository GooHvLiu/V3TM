{
  "name": "v3tm",
  "version": "0.2.0",
  "description": "Vue 3 + Element Plus admin template with dynamic menus, RBAC, i18n and a VitePress docs site.",
  "keywords": [
    "vue3",
    "typescript",
    "vite",
    "element-plus",
    "admin-template",
    "dashboard",
    "rbac",
    "i18n"
  ],
  "author": "GooHv",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooHvLiu/V3TM.git"
  },
  "bugs": {
    "url": "https://github.com/GooHvLiu/V3TM/issues"
  },
  "homepage": "https://github.com/GooHvLiu/V3TM#readme",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "sync:vditor": "node scripts/sync-vditor.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "predev": "npm run sync:vditor",
    "prebuild": "npm run sync:vditor",
    "dev": "vite --open --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs-site --host",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/serve-site.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "primitives:check": "node scripts/check-primitives.mjs",
    "spacing:check": "node scripts/check-spacing.mjs",
    "format": "prettier --write \"*.{json,md,yml,yaml}\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\" \"docs-site/.vitepress/**/*.{ts,css}\"",
    "format:check": "prettier --check \"*.{json,md,yml,yaml}\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\" \"docs-site/.vitepress/**/*.{ts,css}\"",
    "type-check": "vue-tsc -b",
    "type-check:docs": "vue-tsc --noEmit -p tsconfig.docs.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org --audit-level=high",
    "audit:offline": "npm audit --offline",
    "contrast:check": "node scripts/check-contrast.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run lint && npm run primitives:check && npm run spacing:check && npm run contrast:check && npm run type-check && npm run type-check:docs && npm run test:run && npm run build && npm run bundle:check && npm run docs:build"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@formkit/auto-animate": "^0.10.2",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "markdown-it": "^15.0.3",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "vditor": "^4.0.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.1.0",
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/ep": "^1.2.4",
    "@playwright/test": "^1.65.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@conventional-changelog/git-client": "2.6.0",
    "follow-redirects": "1.16.3",
    "git-raw-commits": "5.0.1",
    "glob": "14.0.2",
    "katex": "0.18.2",
    "minimatch": "11.0.1",
    "source-map-js": "1.2.2",
    "vitepress": {
      "vite": {
        "esbuild": "0.25.12"
      }
    }
  }
}
